  "invariants": [
    {
      "id": "INV-001",
      "rule": "L0 ALLAH is not numerically scored"
    },
    {
      "id": "INV-002",
      "rule": "L1 relation/designation/support is not an administrative rank"
    },
    {
      "id": "INV-003",
      "rule": "TH is event-based and is not a permanent human value"
    },
    {
      "id": "INV-004",
      "rule": "TH33 does not imply prophetic identity"
    },
    {
      "id": "INV-005",
      "rule": "TH33 does not merge authority domains"
    },
    {
      "id": "INV-006",
      "rule": "Civil administrative execution must resolve through a civil mandate path"
    },
    {
      "id": "INV-007",
      "rule": "Direct Rasul-to-human guidance is distinct from civil administrative execution"
    },
    {
      "id": "INV-008",
      "rule": "Emergency escalation may increase TH without changing stable identity"
    },
    {
      "id": "INV-009",
      "rule": "Every TH assignment requires reason codes and evidence provenance"
    },
    {
      "id": "INV-010",
      "rule": "Unknown evidence remains UNKNOWN; authority and mission must not be fabricated"
    },
    {
      "id": "INV-011",
      "rule": "Mizan must not claim God's final judgment"
    },
    {
      "id": "INV-012",
      "rule": "Framework assertions remain distinguishable from explicit textual assertions"
    }
