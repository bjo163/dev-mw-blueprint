  "th_resolution": {
    "inputs": [
      "active_role",
      "mission_type",
      "mandate_source",
      "authority_scope",
      "knowledge_scope",
      "event_scope",
      "emergency_state",
      "causal_involvement"
    ],
    "precedence": [
      {
        "when": "special_mission_or_high_mandate_is_active",
        "th": 33
      },
      {
        "when": "expert_or_knowledge_responsibility_is_active",
        "th": 17
      },
      {
        "when": "functional_or_social_responsibility_is_active",
        "th": 5
      },
      {
        "when": "ordinary_human_agency_is_active",
        "th": 2.5
      },
      {
        "when": "passive_minor_role_is_supported",
        "th": 1
      },
      {
        "when": "only_trace_causal_contribution_is_supported",
        "th": "0.x"
      },
      {
        "when": "insufficient_evidence",
        "th": "UNKNOWN"
      }
    ],
    "requires_reason_codes": true,
    "requires_evidence_refs": true
